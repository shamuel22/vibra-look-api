# HTTP
PORT=3000

# YouCam (Perfect Corp) API v2.0 — "API Key" from https://yce.makeupar.com/api-console/
YOUCAM_API_KEY=
YOUCAM_BASE_URL=https://yce-api-01.makeupar.com

# Session lifetime in minutes (selfie, results and YouCam tasks are deleted after this)
SESSION_TTL_MINUTES=30
# Max YouCam renders per session (3 variants + edits); protects the unit budget
MAX_RENDERS_PER_SESSION=12

# Vibe translation (F2.3) — DeepSeek, Anthropic-compatible Messages API.
# `deepseek-flash` is DeepSeek-V4.1-Flash-1017 (verified with GET https://api.deepseek.com/models).
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/anthropic
DEEPSEEK_MODEL=deepseek-flash
